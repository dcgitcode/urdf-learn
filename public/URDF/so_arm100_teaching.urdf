<?xml version="1.0" encoding="utf-8"?>
<!-- 教学副本：规范 visual/origin 层级，保留原模型网格、关节、参数与顺序。 -->
<robot name="so_arm100_simplified_core">
  <link name="Base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/AAA.stl" />
      </geometry>
    </visual>
  </link>
  <link name="yao">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/BBB.stl" />
      </geometry>
    </visual>
  </link>
  <link name="jian1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/CCC.stl" />
      </geometry>
    </visual>
  </link>
  <link name="jian2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/CCC2.stl" />
      </geometry>
    </visual>
  </link>
  <link name="wan">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/DDD.stl" />
      </geometry>
    </visual>
  </link>
  <link name="wan2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/EEE.stl" />
      </geometry>
    </visual>
  </link>
  <link name="zhua">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/FFF.stl" />
      </geometry>
    </visual>
  </link>
  <joint name="Rotation" type="revolute">
    <parent link="Base" />
    <child link="yao" />
    <origin xyz="-0.013 0 0.0265" rpy="0 -1.57 0" />
    <axis xyz="1 0 0" />
    <limit lower="-1.57" upper="1.57" effort="35" velocity="1" />
  </joint>
  <joint name="Rotation2" type="revolute">
    <parent link="yao" />
    <child link="jian1" />
    <origin xyz="0.081 0 0.0" rpy="0  1.57 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57" upper="1.57" effort="35" velocity="1" />
  </joint>
  <joint name="Rotation3" type="revolute">
    <parent link="jian1" />
    <child link="jian2" />
    <origin xyz="0  0 0.118" rpy="0  0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57" upper="1.57" effort="35" velocity="1" />
  </joint>
  <joint name="Rotation4" type="revolute">
    <parent link="jian2" />
    <child link="wan" />
    <origin xyz="0  0 0.118" rpy="0  0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57" upper="1.57" effort="35" velocity="1" />
  </joint>
  <joint name="Rotation5" type="revolute">
    <parent link="wan" />
    <child link="wan2" />
    <origin xyz="0  0 0.0635" rpy="0  0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-1.57" upper="1.57" effort="35" velocity="1" />
  </joint>
  <joint name="Rotation6" type="revolute">
    <parent link="wan2" />
    <child link="zhua" />
    <origin xyz="0  -0.0132 0.021" rpy="0  0 0" />
    <axis xyz="1 0 0" />
    <limit lower="0" upper="1.57" effort="35" velocity="1" />
  </joint>
</robot>
